#!/bin/sh
# Plugin first-run post-install hook (extras only; main +POST_INSTALL is
# auto-generated by Mk/plugins.mk from src/ layout).

set -eu

# Pre-create runtime directories for rendered TOML and cert materialization.
install -d -m 0755 -o root -g wheel /usr/local/etc/trusttunnel
install -d -m 0750 -o root -g wheel /usr/local/etc/trusttunnel/server
install -d -m 0750 -o root -g wheel /usr/local/etc/trusttunnel/server/certs
install -d -m 0750 -o root -g wheel /usr/local/etc/trusttunnel/client

# Pre-create log directory if rc.d wrappers want to drop a file there
# (syslog-ng handles routing via trusttunnel_syslog() hook; this is fallback).
install -d -m 0750 -o root -g wheel /var/log/trusttunnel

exit 0
