<model>
    <mount>//OPNsense/trusttunnel</mount>
    <description>TrustTunnel VPN plugin (Server + Client roles)</description>
    <version>0.1.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
            </enabled>
        </general>

        <!--
            Server role — endpoint daemon (trusttunnel_endpoint) listens on
            $listen_address, serves HTTP/1.1, HTTP/2, and HTTP/3 disguised
            as HTTPS. Cert and key come from System -> Trust (cert_ref).
            credentials.toml is rendered from <users> with nosync="1"
            on passwords to keep them off the HA wire.
        -->
        <server>
            <enabled type="BooleanField">
                <default>0</default>
            </enabled>
            <listen_address type="NetworkAddressField">
                <default>0.0.0.0:443</default>
                <Required>Y</Required>
            </listen_address>
            <hostname type="HostnameField">
                <default>vpn.example.com</default>
                <Required>Y</Required>
            </hostname>
            <allow_private_network_connections type="BooleanField">
                <default>1</default>
            </allow_private_network_connections>
            <ipv6_available type="BooleanField">
                <default>1</default>
            </ipv6_available>
            <protocols type="CSVListField">
                <default>http2,http3</default>
                <Constraints>
                    <check001>
                        <type>CSVListConstraint</type>
                        <ValidationMessage>Each entry must be one of: http1, http2, http3</ValidationMessage>
                        <Values>http1,http2,http3</Values>
                    </check001>
                </Constraints>
            </protocols>
            <cert_ref type="CertificateField">
                <Required>N</Required>
            </cert_ref>
            <firewall_rule_uuid type="UUIDField">
                <!--
                    Plugin-owned firewall rule UUID — populated by
                    ServerController::setAction when Server is enabled.
                    See Task 10 firewall persistence (Codex finding #1).
                -->
            </firewall_rule_uuid>
            <users>
                <user>
                    <username type="TextField">
                        <Required>Y</Required>
                        <Constraints>
                            <check001>
                                <type>RegexConstraint</type>
                                <ValidationMessage>Username must be 1–64 chars, letters/digits/dot/dash/underscore</ValidationMessage>
                                <Pattern>^[A-Za-z0-9._-]{1,64}$</Pattern>
                            </check001>
                        </Constraints>
                    </username>
                    <password type="TextField" nosync="1">
                        <Required>Y</Required>
                        <Mask>/^(.{0,256})$/</Mask>
                    </password>
                </user>
            </users>
        </server>

        <!--
            Client role — connects to one of several known servers via
            trusttunnel_client; each server row's fields map 1:1 onto the
            deeplink TLV tags (see DEEP_LINK.md). active_server picks
            which row drives trusttunnel_client.toml; tun_interface adds a
            UniqueConstraint check against wireguard interfaces.
            Populated fully in Task 9.
        -->
        <client>
            <enabled type="BooleanField">
                <default>0</default>
            </enabled>
            <active_server type="UUIDField"/>
            <mode type="OptionField">
                <default>selective</default>
                <OptionValues>
                    <general>general</general>
                    <selective>selective</selective>
                </OptionValues>
            </mode>
            <tun_interface type="TextField">
                <default>tt0</default>
                <Constraints>
                    <check001>
                        <type>RegexConstraint</type>
                        <ValidationMessage>Interface name must be 1–15 chars, letters/digits/underscore</ValidationMessage>
                        <Pattern>^[A-Za-z][A-Za-z0-9_]{0,14}$</Pattern>
                    </check001>
                </Constraints>
            </tun_interface>
            <allowed_destinations type="CSVListField"/>
            <servers>
                <server>
                    <name type="TextField">
                        <Required>Y</Required>
                        <Mask>/^[\p{L}\p{N}\s._-]{1,64}$/u</Mask>
                    </name>
                    <hostname type="HostnameField">
                        <Required>Y</Required>
                    </hostname>
                    <addresses type="CSVListField">
                        <Required>Y</Required>
                    </addresses>
                    <custom_sni type="TextField"/>
                    <username type="TextField">
                        <Required>Y</Required>
                        <Constraints>
                            <check001>
                                <type>RegexConstraint</type>
                                <ValidationMessage>Username must be 1–64 chars, letters/digits/dot/dash/underscore</ValidationMessage>
                                <Pattern>^[A-Za-z0-9._-]{1,64}$</Pattern>
                            </check001>
                        </Constraints>
                    </username>
                    <password type="TextField" nosync="1">
                        <Required>Y</Required>
                    </password>
                    <certificate_pem type="TextField" nosync="1"/>
                    <skip_verification type="BooleanField">
                        <default>0</default>
                    </skip_verification>
                    <upstream_protocol type="OptionField">
                        <default>http2</default>
                        <OptionValues>
                            <http2>http2</http2>
                            <http3>http3</http3>
                        </OptionValues>
                    </upstream_protocol>
                    <anti_dpi type="BooleanField">
                        <default>0</default>
                    </anti_dpi>
                    <client_random_prefix type="TextField"/>
                    <dns_upstreams type="CSVListField"/>
                </server>
            </servers>
        </client>
    </items>
</model>
