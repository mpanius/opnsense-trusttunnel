<form>
    <field>
        <id>server.name</id>
        <label>Name</label>
        <type>text</type>
        <help>Display name for this server entry.</help>
    </field>
    <field>
        <id>server.hostname</id>
        <label>Hostname</label>
        <type>text</type>
        <hint>vpn.example.com</hint>
    </field>
    <field>
        <id>server.addresses</id>
        <label>Addresses</label>
        <type>text</type>
        <hint>vpn.example.com:443</hint>
        <help>Comma-separated host:port entries.</help>
    </field>
    <field>
        <id>server.custom_sni</id>
        <label>Custom SNI</label>
        <type>text</type>
        <help>Optional. Override TLS SNI (for domain-fronting).</help>
    </field>
    <field>
        <id>server.username</id>
        <label>Username</label>
        <type>text</type>
    </field>
    <field>
        <id>server.password</id>
        <label>Password</label>
        <type>password</type>
    </field>
    <field>
        <id>server.upstream_protocol</id>
        <label>Upstream protocol</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>server.skip_verification</id>
        <label>Skip TLS verification</label>
        <type>checkbox</type>
        <help>Only enable when the server uses an untrusted self-signed cert and you embed the cert PEM below.</help>
    </field>
    <field>
        <id>server.certificate_pem</id>
        <label>Server certificate (PEM)</label>
        <type>textbox</type>
        <help>Self-signed PEM auto-imported from deeplink. Leave empty for ACME/trusted CAs.</help>
    </field>
    <field>
        <id>server.anti_dpi</id>
        <label>Anti-DPI</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>server.client_random_prefix</id>
        <label>Client random prefix</label>
        <type>text</type>
        <help>Hex string (prefix or prefix/mask) for TLS-random anti-fingerprint marker.</help>
    </field>
    <field>
        <id>server.dns_upstreams</id>
        <label>DNS upstreams</label>
        <type>text</type>
        <help>Comma-separated DNS endpoints (1.1.1.1, tls://dns.example, https://dns.example/dns-query).</help>
    </field>
</form>
